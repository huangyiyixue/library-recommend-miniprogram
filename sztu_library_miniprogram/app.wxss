/* app.wxss —— 全局样式：深技大蓝主色 + 简洁卡片风（课程原型） */
page {
  background: #F5F7FA;
  color: #1F2329;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* ---------- 布局 ---------- */
.page { padding: 24rpx 28rpx 80rpx; }
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 34, 67, 0.06);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}
.section-more { font-size: 26rpx; color: #0B4DA2; }

/* ---------- 文本 ---------- */
.title-lg { font-size: 34rpx; font-weight: 600; color: #1F2329; }
.muted { color: #8A9099; font-size: 24rpx; }
.muted-mid { color: #8A9099; font-size: 26rpx; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #EEF3FB;
  color: #0B4DA2;
  margin-right: 12rpx;
}
.tag-gray { background: #F2F4F7; color: #6B7280; }
.tag-green { background: #E8F6EE; color: #1A9C58; }
.tag-orange { background: #FFF2E4; color: #D97008; }
.tag-red { background: #FDECEC; color: #D93636; }

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(90deg, #0B4DA2, #2E7BF6);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 20rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(11, 77, 162, 0.25);
}
.btn-plain {
  background: #FFFFFF;
  color: #0B4DA2;
  border: 2rpx solid #0B4DA2;
  border-radius: 44rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 18rpx 0;
}
.btn-disabled { opacity: 0.5; }

/* ---------- 输入 ---------- */
.input-line {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #E5E8EE;
  padding: 18rpx 0;
}
.input-line input { flex: 1; font-size: 30rpx; }

/* ---------- 书籍列表项 ---------- */
.book-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F2F4F7;
}
.book-item:last-child { border-bottom: none; }
.cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.book-main { flex: 1; margin-left: 20rpx; overflow: hidden; }
.book-title { font-size: 30rpx; font-weight: 600; }
.book-meta { font-size: 24rpx; color: #6B7280; margin-top: 6rpx; }
.book-desc { font-size: 24rpx; color: #8A9099; margin-top: 8rpx; }

/* ---------- 通用 ---------- */
.divider { height: 2rpx; background: #F2F4F7; margin: 24rpx 0; }
.empty { text-align: center; color: #8A9099; font-size: 26rpx; padding: 60rpx 0; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
