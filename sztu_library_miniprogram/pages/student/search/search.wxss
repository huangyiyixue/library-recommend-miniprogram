/* pages/student/search/search.wxss */
.search-bar {
  display: flex; align-items: center;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 34, 67, 0.06);
  margin-bottom: 24rpx;
}
.search-input-wrap { flex: 1; display: flex; align-items: center; }
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; height: 64rpx; }
.ph { color: #B8BEC7; }
.clear { color: #B8BEC7; font-size: 34rpx; padding: 0 12rpx; }
.search-btn {
  background: linear-gradient(90deg, #0B4DA2, #2E7BF6);
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 44rpx;
}

.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 10rpx 22rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #4B5563;
  font-size: 24rpx;
}
.chip-hot { background: #FFF2E4; color: #D97008; }
