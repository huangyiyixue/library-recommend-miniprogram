/* pages/student/mine/mine.wxss */
.user-card {
  background: linear-gradient(135deg, #0B4DA2, #2E7BF6);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFFFFF;
  display: flex; align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 110rpx; height: 110rpx; line-height: 110rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  font-size: 44rpx; font-weight: 600;
}
.user-info { flex: 1; margin-left: 24rpx; overflow: hidden; }
.user-name { font-size: 34rpx; font-weight: 600; }
.user-meta { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }
.logout {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
}

/* 分页标签 */
.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  padding: 16rpx 0;
  border-radius: 16rpx;
}
.tab-on { background: #EEF3FB; color: #0B4DA2; font-weight: 600; }

/* 借阅记录 */
.borrow-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F2F4F7;
}
.borrow-item:last-child { border-bottom: none; }
.borrow-left { flex: 1; overflow: hidden; }
.borrow-right { text-align: right; margin-left: 20rpx; }

/* 偏好 */
.pref-actions { display: flex; }
.pref-actions .section-more { margin-left: 28rpx; }
.danger { color: #D93636; }
.pref-row { display: flex; flex-wrap: wrap; align-items: center; margin-bottom: 18rpx; }
.pref-k { width: 150rpx; font-size: 24rpx; color: #8A9099; }
.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 8rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  background: #EEF3FB;
  color: #0B4DA2;
  font-size: 24rpx;
}

/* 弹窗 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.modal {
  width: 640rpx; max-height: 84vh;
  background: #FFFFFF; border-radius: 24rpx; padding: 32rpx;
  display: flex; flex-direction: column;
}
.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; }
.modal-sub { font-size: 22rpx; color: #8A9099; text-align: center; margin: 10rpx 0 20rpx; }
.modal-body { flex: 1; }
.form-block { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.chip-on { background: #0B4DA2; color: #FFFFFF; }
.modal-input {
  border: 2rpx solid #E5E8EE; border-radius: 12rpx;
  padding: 16rpx; font-size: 26rpx; margin-top: 8rpx;
}
.ph { color: #B8BEC7; }
.modal-actions { display: flex; margin-top: 20rpx; }
.modal-btn { flex: 1; margin: 0 10rpx; }
